# ---------- RPC ----------
# Free public RPC works for dry-run. For anything serious, get a free
# Helius / QuickNode / Triton endpoint and paste it here.
RPC_URL=https://api.mainnet-beta.solana.com

# ---------- Jupiter API ----------
# Free key from https://portal.jup.ag -> uses api.jup.ag (10 req / 10 s on the
# free tier, with rate-limit headers the scanner paces itself by). Leave
# empty to fall back to lite-api.jup.ag (no key, stricter, no headers).
JUP_API_KEY=
# Endpoints drift over time. If quotes 404, check https://dev.jup.ag and
# update this base URL only. Default: api.jup.ag if key set, else lite-api.
#JUP_BASE=https://api.jup.ag/swap/v1

# ---------- Strategy ----------
TRADE_SIZE_SOL=0.02
MIN_PROFIT_BPS=25
SLIPPAGE_BPS=30
# Real execution gate (lamports, not bps): the worst-case fill (legB's on-chain
# minimum out) must beat Jito tip + ~15k base fees by at least this much.
MIN_NET_LAMPORTS=1000
# Floor between scans. The Jupiter limiter paces requests by rate-limit
# headers, so this can be low; a full 5-token scan is 10 requests = one
# free-tier window (~10 s) regardless. Trim src/tokens.ts to scan faster.
SCAN_INTERVAL_MS=1000

# ---------- Execution (paper mode by default) ----------
DRY_RUN=true
WALLET_KEYPAIR=./wallet.json

# ---------- Jito (only used when DRY_RUN=false) ----------
USE_JITO=true
JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf/api/v1/bundles
# 100000 lamports = 0.0001 SOL. Winners pay 50-70% of profit; this floor
# exists so a stray fill can't drain you while you learn tip calibration.
JITO_TIP_LAMPORTS=100000
